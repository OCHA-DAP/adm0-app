---
import "../styles/brand.css";
import "../styles/site-tokens.css";
import FontFaces from "$lib/components/FontFaces.astro";
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="robots" content="noindex" />
    <title></title>
    <FontFaces />
  </head>
  <body>
    <slot />
  </body>
</html>

<style is:global>
  :root {
    --panel-shadow: 0 1px 4px rgb(0 0 0 / 25%);
  }
  *,
  *::before,
  *::after {
    box-sizing: border-box;
  }
  html,
  body {
    margin: 0;
    padding: 0;
    height: 100%;
    color: var(--cd-grey--900);
    font-family: var(--cd-font--roboto, Roboto, sans-serif);
  }
  button,
  input {
    font-family: inherit;
  }
  .hidden {
    display: none !important;
  }
  th,
  td {
    text-align: left;
    vertical-align: top;
    border-bottom: 1px solid var(--cd-grey--300);
  }
  .panel {
    position: absolute;
    top: 0.75rem;
    max-height: calc(100% - 1.5rem);
    overflow-y: auto;
    padding: 0.75rem;
    background: var(--cd-white);
    border-radius: 4px;
    box-shadow: var(--panel-shadow);
    font-size: 0.875rem;
    z-index: 3;
  }
  .panel h2 {
    font-size: 0.75rem;
    text-transform: uppercase;
    color: var(--brand-grey--text);
    margin: 1rem 0 0.25rem;
  }
  .badge {
    display: inline-block;
    min-width: 1.1rem;
    margin-right: 0.3rem;
    color: var(--cd-white);
    background: var(--color);
    border-radius: 3px;
    font-size: 0.6875rem;
    font-weight: 700;
    text-align: center;
  }
</style>
